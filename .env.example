# Captain Toto — environment variables
# Copy this file to ".env.local" and fill in your real Supabase values.
# Find these in Supabase: Project Settings → API.
#
# Until these are set, the app runs in DEMO mode: data is kept in memory
# and resets when the server restarts. Set them to persist data to Supabase.
#
# Auth: create users in Supabase → Authentication → Users (no public signup).
# After first login user is created, promote yourself:
#   update public.profiles set role = 'ceo' where id = '<user-uuid>';
# Also set Auth Site URL / Redirect URLs to your Vercel domain and localhost.

NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
