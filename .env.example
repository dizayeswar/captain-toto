# Captain Toto — environment variables
# Copy this file to ".env.local" and fill in your real Supabase values.
# Find these in Supabase: Project Settings → API.
#
# Until these are set, the app runs in DEMO mode: bookings are kept in memory
# and reset when the server restarts. Set them to persist data to Supabase.

NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
